{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 32px 24px;
    box-sizing: border-box;
  }
  .ai-timeline-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-timeline-{{ ai_gen_id }}__inner { max-width: 900px; margin: 0 auto; }
  .ai-timeline-{{ ai_gen_id }}__heading { margin: 0 0 32px; font-size: clamp(24px, 3vw, 36px); line-height: 1.2; color: inherit; }
  .ai-timeline-{{ ai_gen_id }}__list { position: relative; list-style: none; padding: 0; margin: 0; }
  .ai-timeline-{{ ai_gen_id }}__list::before, .ai-timeline-{{ ai_gen_id }}__progress { content: ''; position: absolute; left: 14px; top: 16px; width: 3px; height: calc(100% - 32px); background: {{ block.settings.track_color }}; border-radius: 3px; }
  .ai-timeline-{{ ai_gen_id }}__progress { height: 0; background: {{ block.settings.accent_color }}; z-index: 1; transition: height 180ms ease-out; }
  .ai-timeline-{{ ai_gen_id }}__item { position: relative; padding: 0 0 36px 52px; }
  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }}__marker { position: absolute; z-index: 2; left: 5px; top: 2px; display: grid; place-items: center; width: 22px; height: 22px; border: 3px solid {{ block.settings.track_color }}; border-radius: 50%; background: {{ block.settings.background_color }}; color: {{ block.settings.marker_text_color }}; font-size: 11px; font-weight: 700; transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease; }
  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker { border-color: {{ block.settings.accent_color }}; background: {{ block.settings.accent_color }}; color: #ffffff; }
  .ai-timeline-{{ ai_gen_id }}__date { display: block; margin: 0 0 6px; color: {{ block.settings.accent_color }}; font-size: 13px; font-weight: 700; letter-spacing: .04em; }
  .ai-timeline-{{ ai_gen_id }}__title { margin: 0 0 8px; font-size: 20px; line-height: 1.3; color: inherit; }
  .ai-timeline-{{ ai_gen_id }}__body { font-size: 16px; line-height: 1.6; color: inherit; }
  .ai-timeline-{{ ai_gen_id }}__body p { margin: 0; }
  .ai-timeline-{{ ai_gen_id }}__item:focus-within .ai-timeline-{{ ai_gen_id }}__marker { outline: 2px solid {{ block.settings.accent_color }}; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .ai-timeline-{{ ai_gen_id }}__progress, .ai-timeline-{{ ai_gen_id }}__marker { transition: none; } }
  @media screen and (max-width: 749px) { .ai-timeline-{{ ai_gen_id }} { padding: 24px 18px; } .ai-timeline-{{ ai_gen_id }}__item { padding-left: 44px; padding-bottom: 30px; } }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <ol class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
      <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
      {% for i in (1..5) %}
        {% assign title_key = 'item_' | append: i | append: '_title' %}
        {% assign date_key = 'item_' | append: i | append: '_date' %}
        {% assign body_key = 'item_' | append: i | append: '_text' %}
        {% assign item_title = block.settings[title_key] %}
        {% assign item_date = block.settings[date_key] %}
        {% assign item_text = block.settings[body_key] %}
        {% if item_title != blank or item_date != blank or item_text != blank %}
          <li class="ai-timeline-{{ ai_gen_id }}__item">
            <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true">{{ forloop.index }}</span>
            {% if item_date != blank %}<span class="ai-timeline-{{ ai_gen_id }}__date">{{ item_date | escape }}</span>{% endif %}
            {% if item_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ item_title | escape }}</h3>{% endif %}
            {% if item_text != blank %}<div class="ai-timeline-{{ ai_gen_id }}__body">{{ item_text }}</div>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline-{{ ai_gen_id }}__item'));
        this.progress = this.querySelector('.ai-timeline-{{ ai_gen_id }}__progress');
        if (!this.items.length || !this.progress) return;
        this.onScroll = () => this.updateTimeline();
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.items.forEach((item) => item.classList.toggle('is-active', item === entry.target));
              this.updateTimeline();
            }
          });
        }, { rootMargin: '-40% 0px -45% 0px', threshold: 0 });
        this.items.forEach((item) => this.observer.observe(item));
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll);
        this.items[0].classList.add('is-active');
        this.updateTimeline();
      }
      updateTimeline() {
        const activeIndex = this.items.findIndex((item) => item.classList.contains('is-active'));
        if (activeIndex < 0) return;
        const listRect = this.querySelector('.ai-timeline-{{ ai_gen_id }}__list').getBoundingClientRect();
        const markerRect = this.items[activeIndex].querySelector('.ai-timeline-{{ ai_gen_id }}__marker').getBoundingClientRect();
        const height = Math.max(0, markerRect.top + markerRect.height / 2 - listRect.top - 16);
        this.progress.style.height = `${height}px`;
      }
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        if (this.onScroll) {
          window.removeEventListener('scroll', this.onScroll);
          window.removeEventListener('resize', this.onScroll);
        }
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Highlight", "default": "#CC0000" },
    { "type": "color", "id": "track_color", "label": "Timeline track", "default": "#767676" },
    { "type": "color", "id": "marker_text_color", "label": "Marker text", "default": "#121212" },
    { "type": "header", "content": "Timeline items" },
    { "type": "text", "id": "item_1_date", "label": "Item 1 date or label" },
    { "type": "text", "id": "item_1_title", "label": "Item 1 title", "default": "A new beginning" },
    { "type": "richtext", "id": "item_1_text", "label": "Item 1 text", "default": "<p>Add a short description for this milestone.</p>" },
    { "type": "text", "id": "item_2_date", "label": "Item 2 date or label", "default": "Next chapter" },
    { "type": "text", "id": "item_2_title", "label": "Item 2 title", "default": "Growing together" },
    { "type": "richtext", "id": "item_2_text", "label": "Item 2 text", "default": "<p>Share another important moment in your story.</p>" },
    { "type": "text", "id": "item_3_date", "label": "Item 3 date or label", "default": "Milestone" },
    { "type": "text", "id": "item_3_title", "label": "Item 3 title", "default": "Making an impact" },
    { "type": "richtext", "id": "item_3_text", "label": "Item 3 text", "default": "<p>Explain what changed and why it matters.</p>" },
    { "type": "text", "id": "item_4_date", "label": "Item 4 date or label", "default": "Today" },
    { "type": "text", "id": "item_4_title", "label": "Item 4 title", "default": "Looking ahead" },
    { "type": "richtext", "id": "item_4_text", "label": "Item 4 text", "default": "<p>Describe what comes next.</p>" },
    { "type": "text", "id": "item_5_date", "label": "Item 5 date or label", "default": "Coming soon" },
    { "type": "text", "id": "item_5_title", "label": "Item 5 title", "default": "The next milestone" },
    { "type": "richtext", "id": "item_5_text", "label": "Item 5 text", "default": "<p>Add one more milestone, or clear this item to hide it.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}