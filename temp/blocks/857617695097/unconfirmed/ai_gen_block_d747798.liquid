{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 32px;
    box-sizing: border-box;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 28px;
    font-size: {{ block.settings.heading_size }}px;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__list-{{ ai_gen_id }}::before,
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__progress-{{ ai_gen_id }} {
    content: '';
    position: absolute;
    left: 15px;
    top: 12px;
    width: 2px;
    height: calc(100% - 24px);
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__list-{{ ai_gen_id }}::before { background: {{ block.settings.line_color }}; }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__progress-{{ ai_gen_id }} {
    height: 0;
    max-height: calc(100% - 24px);
    background: {{ block.settings.active_color }};
    transition: height 120ms linear;
    z-index: 1;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__item-{{ ai_gen_id }} {
    position: relative;
    padding: 0 0 36px 52px;
    min-height: 72px;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__item-{{ ai_gen_id }}:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__marker-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    left: 7px;
    top: 3px;
    width: 18px;
    height: 18px;
    border: 2px solid {{ block.settings.line_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    box-sizing: border-box;
    transition: background-color 180ms ease, border-color 180ms ease;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__item-{{ ai_gen_id }}.is-active .ai-timeline__marker-{{ ai_gen_id }} {
    border-color: {{ block.settings.active_color }};
    background: {{ block.settings.active_color }};
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__date-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 6px;
    color: {{ block.settings.active_color }};
    font-size: 13px;
    font-weight: 700;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__title-{{ ai_gen_id }} {
    margin: 0 0 7px;
    color: {{ block.settings.text_color }};
    font-size: 20px;
    line-height: 1.3;
  }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__body-{{ ai_gen_id }} { color: {{ block.settings.text_color }}; line-height: 1.6; }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__body-{{ ai_gen_id }} p { margin: 0; }
  .ai-timeline-{{ ai_gen_id }} .ai-timeline__body-{{ ai_gen_id }} p + p { margin-top: 10px; }
  @media screen and (max-width: 749px) {
    .ai-timeline-{{ ai_gen_id }} { padding: 24px 18px; }
    .ai-timeline-{{ ai_gen_id }} .ai-timeline__heading-{{ ai_gen_id }} { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }} .ai-timeline__marker-{{ ai_gen_id }},
    .ai-timeline-{{ ai_gen_id }} .ai-timeline__progress-{{ ai_gen_id }} { transition: none; }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-timeline__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  <ol class="ai-timeline__list-{{ ai_gen_id }}" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
    <span class="ai-timeline__progress-{{ ai_gen_id }}" aria-hidden="true"></span>
    {% for i in (1..5) %}
      {% liquid
        assign title_key = 'event_' | append: i | append: '_title'
        assign date_key = 'event_' | append: i | append: '_date'
        assign body_key = 'event_' | append: i | append: '_body'
        assign event_title = block.settings[title_key]
        assign event_date = block.settings[date_key]
        assign event_body = block.settings[body_key]
      %}
      {% if event_title != blank %}
        <li class="ai-timeline__item-{{ ai_gen_id }}">
          <span class="ai-timeline__marker-{{ ai_gen_id }}" aria-hidden="true"></span>
          {% if event_date != blank %}<span class="ai-timeline__date-{{ ai_gen_id }}">{{ event_date | escape }}</span>{% endif %}
          <h3 class="ai-timeline__title-{{ ai_gen_id }}">{{ event_title | escape }}</h3>
          {% if event_body != blank %}<div class="ai-timeline__body-{{ ai_gen_id }}">{{ event_body }}</div>{% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ol>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline__item-{{ ai_gen_id }}'));
        this.progress = this.querySelector('.ai-timeline__progress-{{ ai_gen_id }}');
        if (!this.items.length || !this.progress) return;
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.items.forEach((item) => item.classList.toggle('is-active', item === entry.target));
              this.updateProgress(entry.target);
            }
          });
        }, { rootMargin: '-35% 0px -50% 0px', threshold: 0 });
        this.items.forEach((item) => this.observer.observe(item));
        this.items[0].classList.add('is-active');
        this.updateProgress(this.items[0]);
      }
      updateProgress(item) {
        const listRect = this.querySelector('.ai-timeline__list-{{ ai_gen_id }}').getBoundingClientRect();
        const itemRect = item.getBoundingClientRect();
        const distance = Math.max(0, itemRect.top - listRect.top + 12);
        this.progress.style.height = Math.min(distance, Math.max(0, listRect.height - 24)) + 'px';
      }
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "line_color", "label": "Timeline line", "default": "#767676" },
    { "type": "color", "id": "active_color", "label": "Highlight", "default": "#CC0000" },
    { "type": "header", "content": "Timeline events" },
    { "type": "text", "id": "event_1_date", "label": "Event 1 date" },
    { "type": "text", "id": "event_1_title", "label": "Event 1 title", "default": "A new beginning" },
    { "type": "richtext", "id": "event_1_body", "label": "Event 1 description", "default": "<p>Add a short description for this milestone.</p>" },
    { "type": "text", "id": "event_2_date", "label": "Event 2 date" },
    { "type": "text", "id": "event_2_title", "label": "Event 2 title", "default": "Growing together" },
    { "type": "richtext", "id": "event_2_body", "label": "Event 2 description", "default": "<p>Share the next important moment in your story.</p>" },
    { "type": "text", "id": "event_3_date", "label": "Event 3 date" },
    { "type": "text", "id": "event_3_title", "label": "Event 3 title", "default": "Making an impact" },
    { "type": "richtext", "id": "event_3_body", "label": "Event 3 description", "default": "<p>Explain what made this milestone meaningful.</p>" },
    { "type": "text", "id": "event_4_date", "label": "Event 4 date" },
    { "type": "text", "id": "event_4_title", "label": "Event 4 title", "default": "Looking ahead" },
    { "type": "richtext", "id": "event_4_body", "label": "Event 4 description", "default": "<p>Tell customers what comes next.</p>" },
    { "type": "text", "id": "event_5_date", "label": "Event 5 date" },
    { "type": "text", "id": "event_5_title", "label": "Event 5 title", "default": "The story continues" },
    { "type": "richtext", "id": "event_5_body", "label": "Event 5 description", "default": "<p>Add a final milestone or remove its title to hide it.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}