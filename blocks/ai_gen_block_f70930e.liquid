{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 32px 24px;
    box-sizing: border-box;
  }
  .ai-timeline-{{ ai_gen_id }}__inner { max-width: 760px; margin: 0 auto; }
  .ai-timeline-{{ ai_gen_id }}__heading { margin: 0 0 28px; color: {{ block.settings.text_color }}; font-size: clamp(24px, 4vw, 36px); line-height: 1.2; }
  .ai-timeline-{{ ai_gen_id }}__list { position: relative; margin: 0; padding: 0; list-style: none; }
  .ai-timeline-{{ ai_gen_id }}__list::before { content: ''; position: absolute; left: 13px; top: 14px; bottom: 14px; width: 2px; background: {{ block.settings.line_color }}; }
  .ai-timeline-{{ ai_gen_id }}__item { position: relative; padding: 0 0 32px 48px; }
  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }}__marker { position: absolute; left: 5px; top: 3px; z-index: 1; width: 18px; height: 18px; box-sizing: border-box; border-radius: 50%; border: 3px solid {{ block.settings.line_color }}; background: {{ block.settings.background_color }}; transition: background-color .2s ease, border-color .2s ease; }
  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker { background: {{ block.settings.highlight_color }}; border-color: {{ block.settings.highlight_color }}; }
  .ai-timeline-{{ ai_gen_id }}__date { display: block; margin: 0 0 6px; color: {{ block.settings.highlight_color }}; font-size: 14px; font-weight: 700; letter-spacing: .04em; }
  .ai-timeline-{{ ai_gen_id }}__title { margin: 0 0 8px; color: {{ block.settings.text_color }}; font-size: 20px; line-height: 1.3; }
  .ai-timeline-{{ ai_gen_id }}__copy { color: {{ block.settings.text_color }}; font-size: 16px; line-height: 1.55; }
  .ai-timeline-{{ ai_gen_id }}__copy p { margin: 0; }
  .ai-timeline-{{ ai_gen_id }}__item:focus { outline: 2px solid {{ block.settings.highlight_color }}; outline-offset: 5px; }
  @media (max-width: 749px) { .ai-timeline-{{ ai_gen_id }} { padding: 24px 16px; } .ai-timeline-{{ ai_gen_id }}__item { padding-left: 40px; } }
  @media (prefers-reduced-motion: reduce) { .ai-timeline-{{ ai_gen_id }}__marker { transition: none; } }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <ol class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
      {% for i in (1..5) %}
        {% liquid
          assign title_key = 'event_' | append: i | append: '_title'
          assign date_key = 'event_' | append: i | append: '_date'
          assign copy_key = 'event_' | append: i | append: '_text'
          assign event_title = block.settings[title_key]
          assign event_date = block.settings[date_key]
          assign event_copy = block.settings[copy_key]
        %}
        {% if event_title != blank or event_date != blank or event_copy != blank %}
          <li class="ai-timeline-{{ ai_gen_id }}__item" tabindex="0">
            <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true"></span>
            {% if event_date != blank %}<time class="ai-timeline-{{ ai_gen_id }}__date">{{ event_date | escape }}</time>{% endif %}
            {% if event_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ event_title | escape }}</h3>{% endif %}
            {% if event_copy != blank %}<div class="ai-timeline-{{ ai_gen_id }}__copy">{{ event_copy }}</div>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline-{{ ai_gen_id }}__item'));
        if (!this.items.length) return;
        if (!('IntersectionObserver' in window)) {
          this.items[0].classList.add('is-active');
          return;
        }
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.items.forEach((item) => item.classList.toggle('is-active', item === entry.target));
            }
          });
        }, { rootMargin: '-35% 0px -45% 0px', threshold: 0 });
        this.items.forEach((item) => this.observer.observe(item));
        this.onFocus = (event) => {
          const item = event.target.closest('.ai-timeline-{{ ai_gen_id }}__item');
          if (item && this.contains(item)) this.items.forEach((entry) => entry.classList.toggle('is-active', entry === item));
        };
        this.addEventListener('focusin', this.onFocus);
      }
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        if (this.onFocus) this.removeEventListener('focusin', this.onFocus);
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our timeline" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "line_color", "label": "Timeline line", "default": "#767676" },
    { "type": "color", "id": "highlight_color", "label": "Highlight", "default": "#cc0000" },
    { "type": "header", "content": "Event 1" },
    { "type": "text", "id": "event_1_date", "label": "Date or label", "default": "Step one" },
    { "type": "text", "id": "event_1_title", "label": "Title", "default": "First milestone" },
    { "type": "richtext", "id": "event_1_text", "label": "Description", "default": "<p>Add details about this milestone.</p>" },
    { "type": "header", "content": "Event 2" },
    { "type": "text", "id": "event_2_date", "label": "Date or label", "default": "Step two" },
    { "type": "text", "id": "event_2_title", "label": "Title", "default": "Second milestone" },
    { "type": "richtext", "id": "event_2_text", "label": "Description", "default": "<p>Add details about this milestone.</p>" },
    { "type": "header", "content": "Event 3" },
    { "type": "text", "id": "event_3_date", "label": "Date or label", "default": "Step three" },
    { "type": "text", "id": "event_3_title", "label": "Title", "default": "Third milestone" },
    { "type": "richtext", "id": "event_3_text", "label": "Description", "default": "<p>Add details about this milestone.</p>" },
    { "type": "header", "content": "Event 4" },
    { "type": "text", "id": "event_4_date", "label": "Date or label", "default": "Step four" },
    { "type": "text", "id": "event_4_title", "label": "Title", "default": "Fourth milestone" },
    { "type": "richtext", "id": "event_4_text", "label": "Description", "default": "<p>Add details about this milestone.</p>" },
    { "type": "header", "content": "Event 5" },
    { "type": "text", "id": "event_5_date", "label": "Date or label", "default": "Step five" },
    { "type": "text", "id": "event_5_title", "label": "Title", "default": "Fifth milestone" },
    { "type": "richtext", "id": "event_5_text", "label": "Description", "default": "<p>Add details about this milestone.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}